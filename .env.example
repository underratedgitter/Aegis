# Optional: when present, Aegis uses an OpenAI tool-calling investigator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Leave these as-is for Docker Compose. For local Python runs, point them at your services.
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
CHECKOUT_URL=http://checkout:8000
INVENTORY_URL=http://inventory:8000
AEGIS_DB_PATH=/data/aegis.db
AEGIS_LOG_DIR=/var/log/aegis

# Required for fault injection and remediation. When set, every control-plane
# route that changes state also requires `Authorization: Bearer <key>`, and the
# demo services' /admin/* routes reject requests without it. `make start`
# generates a local key in .env when one is missing.
AEGIS_API_KEY=

# Bind published Compose ports to loopback by default. Set to 0.0.0.0 only
# behind a trusted reverse proxy with AEGIS_API_KEY configured.
AEGIS_BIND_ADDR=127.0.0.1

# Per-client request budget for the control plane.
AEGIS_RATE_LIMIT_WINDOW=60
AEGIS_RATE_LIMIT_MAX=100
